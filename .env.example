# Rename this file to `.env` and fill in real values.
# NEVER commit `.env`. All secrets stay in your environment / secret manager.

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://gadgeto:gadgeto@localhost:5432/gadgeto
SECRET_KEY=CHANGE_ME_random_string_of_at_least_32_chars
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- LiqPay ---
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_TEST_MODE=true
LIQPAY_TEST_PUBLIC_KEY=
LIQPAY_TEST_PRIVATE_KEY=

# --- Nova Poshta ---
NOVAPOSHTA_API_KEY=
NOVAPOSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/

# --- Email (Brevo) ---
# Get these from your Brevo (Sendinblue) account
# The API key is read server-side only — NEVER use NEXT_PUBLIC_ prefix.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@gadgeto.com.ua
BREVO_SENDER_NAME=Gadgeto

# --- Email (SMTP fallback) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@gadgeto.com.ua

# --- Media ---
MEDIA_DIR=./media
MEDIA_BASE_URL=/media

# --- Suppliers (credentials only via env, never committed) ---
SUPPLIER_ITLINK_USERNAME=
SUPPLIER_ITLINK_PASSWORD=
SUPPLIER_ITLINK_PRICE_ID=
SUPPLIER_ITLINK_CUSTOMER_ID=
SUPPLIER_DCLINK_LOGIN=
SUPPLIER_DCLINK_PASSWORD=

ROZETKA_SELLER_USERNAME=your_login
ROZETKA_SELLER_PASSWORD=your_password

# --- Catalog Automation (Celery/Redis) ---
# Redis / Celery broker — point at the docker compose `redis` service in dev
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CATALOG_SYNC_REDIS_URL=redis://localhost:6379/0

# Master switch (overrideable via admin UI enable/disable at runtime)
CATALOG_SYNC_ENABLED=true
# Sync cadence (hours): e.g. 4 → every 4 hours
CATALOG_SYNC_INTERVAL_HOURS=4
# Anchor hour: 2 → runs at 02:00, 06:00, 10:00, 14:00, 18:00, 22:00
CATALOG_SYNC_ANCHOR_HOUR=2
# Lock TTL (seconds): must exceed longest realistic full sync
CATALOG_SYNC_LOCK_TIMEOUT=21600
# Max retries for transient failures
CATALOG_SYNC_MAX_RETRIES=3
