# Rename this file to `.env` and fill in real values.
# NEVER commit `.env`. All secrets stay in your environment / secret manager.

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://gadgeto:gadgeto@localhost:5432/gadgeto
SECRET_KEY=CHANGE_ME_random_string_of_at_least_32_chars
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- LiqPay ---
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_TEST_MODE=true
LIQPAY_TEST_PUBLIC_KEY=
LIQPAY_TEST_PRIVATE_KEY=

# --- Nova Poshta ---
NOVAPOSHTA_API_KEY=
NOVAPOSHTA_API_URL=https://api.novaposhta.ua/v2.0/json/

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@gadgeto.com.ua

# --- Media ---
MEDIA_DIR=./media
MEDIA_BASE_URL=/media

# --- Suppliers (credentials only via env, never committed) ---
SUPPLIER_ITLINK_USERNAME=
SUPPLIER_ITLINK_PASSWORD=
SUPPLIER_ITLINK_PRICE_ID=
SUPPLIER_ITLINK_CUSTOMER_ID=
SUPPLIER_DCLINK_LOGIN=
SUPPLIER_DCLINK_PASSWORD=